rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Band catalog: readable by anyone (used to populate Discover/search),
    // writable only by Cloud Functions via the Admin SDK.
    match /bands/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // Polling cursor used internally by the pollMetalitalia function.
    match /meta/{document} {
      allow read, write: if false;
    }

    // Each signed-in user can only access their own followed-bands doc.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
